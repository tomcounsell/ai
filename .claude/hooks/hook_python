#!/bin/sh
# Resolve the repo venv interpreter for a Claude Code hook.
# Hooks run under a non-interactive /bin/sh with no PATH guarantees (issue #2503).
#
# PRECEDENCE IS DELIBERATE AND MAIN-CHECKOUT-FIRST. 9 of 57 worktrees carry an
# unmanaged .venv with a divergent Python (measured: main 3.14.3 vs 3.13.2), so a
# local-first order would silently exec a stale interpreter. Resolve the main
# checkout via git FIRST; only fall back to $root when git cannot answer.
root="${CLAUDE_PROJECT_DIR:-$PWD}"

# Fail open on a missing script BEFORE resolving an interpreter. CPython exits 2
# when it cannot open its script file, and 2 is Claude Code's DENY code, so under
# an `exit_policy` of `deny-only` or `propagate` an absent script denies every
# tool call in the checkout — silently, for every session type. The interpreter
# is resolved main-checkout-first while the script path comes from
# $CLAUDE_PROJECT_DIR, so "interpreter present, script absent" is reachable
# whenever the two diverge: a worktree branched before the hook existed, a
# partial checkout, or the replace-and-rename window inside /update.
# Same two destinations and one message string as the no-interpreter branch.
# Only a script-path argument is checked; a leading `-` is an interpreter flag
# (`-V`, `-c`, ...) and is passed through untouched.
case "$1" in
-* | "") script="" ;;
*) script="$1" ;;
esac
if [ -n "$script" ] && [ ! -f "$script" ]; then
  msg="hook_python: hook script not found: $script"
  echo "$msg" >&2
  {
    mkdir -p "$root/logs" &&
      printf '%s - hook_python - ERROR - %s\n' \
        "$(date -u '+%Y-%m-%d %H:%M:%S')" "$msg" >>"$root/logs/hooks.log"
  } 2>/dev/null || true
  exit 0
fi

common=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
if [ -n "$common" ]; then
  main=$(dirname "$common")
  if [ -x "$main/.venv/bin/python" ]; then exec "$main/.venv/bin/python" "$@"; fi
fi
# Non-git checkout, or a main checkout git could not identify.
if [ -x "$root/.venv/bin/python" ]; then exec "$root/.venv/bin/python" "$@"; fi
# Fail-open. Two destinations, ONE message string:
#   - stderr, which Claude Code surfaces on its hook-error channel;
#   - "$root/logs/hooks.log", in log_hook_error's exact format
#     (`%Y-%m-%d %H:%M:%S - {hook} - ERROR - {message}`, UTC), which is what
#     makes reflections/audits/hooks_audit.py's dedicated shim finding
#     reachable. No Python runs on this branch, so the shim is the only thing
#     that can emit that record.
# The append is fully guarded: it must never touch stdout (hook stdout is
# parsed as JSON) and never change the exit code.
msg="hook_python: no repo venv interpreter found under $root"
echo "$msg" >&2
{
  mkdir -p "$root/logs" &&
    printf '%s - hook_python - ERROR - %s\n' \
      "$(date -u '+%Y-%m-%d %H:%M:%S')" "$msg" >>"$root/logs/hooks.log"
} 2>/dev/null || true
exit 0
