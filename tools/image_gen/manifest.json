{
  "name": "image_gen",
  "version": "2.0.0",
  "description": "AI image generation via gpt-image-1 (OpenAI) with Gemini fallback via OpenRouter",
  "type": "library",
  "status": "stable",

  "source": {
    "type": "internal",
    "repository": "https://github.com/tomcounsell/ai"
  },

  "capabilities": [
    "generate"
  ],

  "requires": {
    "env": ["OPENAI_API_KEY"],
    "env_optional": ["OPENROUTER_API_KEY"],
    "python": ">=3.10"
  },

  "config": {
    "default_provider": "openai",
    "default_model": "gpt-image-1",
    "models": [
      "gpt-image-1",
      "google/gemini-3-pro-image-preview"
    ],
    "aspect_ratios": ["1:1", "16:9", "9:16", "4:3", "3:4", "3:2", "2:3", "21:9"]
  },

  "commands": {
    "verify": "python -c \"from tools.image_gen import generate_image; print('OK')\"",
    "test": "pytest tools/image_gen/tests/ -v"
  },

  "workflows": [
    {
      "name": "basic-generation",
      "description": "Generate an image from a text prompt",
      "steps": [
        "from tools.image_gen import generate_image",
        "result = generate_image('a cat in space')",
        "# Returns: {'images': ['generated_images/image_20260612_1.png'], 'provider': 'openai', ...}"
      ]
    }
  ]
}
