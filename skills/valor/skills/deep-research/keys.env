# Where run.py reads each research key: 1Password references
# read with `op read`. Each reference here wins over the environment's key; the
# environment's is used only when `op read` fails.
PERPLEXITY_API_KEY=op://m-valor/PERPLEXITY_API_KEY/credential
OPENAI_API_KEY=op://m-valor/OPENAI_API_KEY/credential
# The GEMINI_API_KEY item is a free-tier key, which Gemini deep research refuses;
# GOOGLE_API_KEY was accepted on 2026-11-02.
GEMINI_API_KEY=op://m-valor/GOOGLE_API_KEY/credential
GROK_API_KEY=op://m-valor/Grok x.ai API Key/API_KEY
ANTHROPIC_API_KEY=op://m-valor/ANTHROPIC_API_KEY/credential
OPENROUTER_API_KEY=op://m-valor/OPENROUTER_API_KEY/credential
