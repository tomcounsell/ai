{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [{"type": "command", "command": "/usr/bin/python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/web_only.py\" || exit 2"}]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [{"type": "command", "command": "/usr/bin/python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent_start.py\""}]
      }
    ]
  }
}
