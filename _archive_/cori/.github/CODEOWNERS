# Trust boundary. Tech stack §10. A change here needs a human review that a
# builder agent cannot give itself. The ruleset on main (.github/rulesets/)
# refuses deletion and force-push only; the review is a practice until
# builders run under their own identity.

# This file
/.github/CODEOWNERS               @tomcounsell

# CI configuration
/.github/                         @tomcounsell

# The kernel, the gateway, the broker, the contract, the schema
/kernel/                          @tomcounsell
/gateway/                         @tomcounsell
/broker/                          @tomcounsell
/schemas/                         @tomcounsell
/migrations/                      @tomcounsell
/alembic.ini                      @tomcounsell

# Machine configuration and the seat file
/infra/                           @tomcounsell

# Import rules and the dependency lock
/pyproject.toml                   @tomcounsell
/uv.lock                          @tomcounsell

# Prompts inside the boundary: the supervisor's, every Verifier prompt and
# checklist, and VOICE.md, the one norms document every seat reads. Framing
# is the supervisor's own turn, so there is no Framer prompt. Declared ahead
# of the files so the first one lands under review. Executor and summarizer
# paragraphs stay outside, behind evals.
/prompts/supervisor/              @tomcounsell
/prompts/verifier/                @tomcounsell
/VOICE.md                         @tomcounsell

# Space manifests
/infra/spaces/                    @tomcounsell
